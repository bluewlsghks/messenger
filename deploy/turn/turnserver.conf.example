# Copy outside Git. This is NOT a working public TURN service until network/TLS is configured.
listening-port=3478
tls-listening-port=5349
realm=messenger.example.invalid
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_A_RANDOM_SECRET_MATCHING_VOICE_TURN_SECRET
# Set real listening, relay and public/private NAT addresses for the TURN host.
# listening-ip=...
# relay-ip=...
# external-ip=PUBLIC_IP/PRIVATE_IP
min-port=49160
max-port=49200
user-quota=8
total-quota=200
max-bps=1000000
stale-nonce=600
no-cli
no-multicast-peers
no-tlsv1
no-tlsv1_1
# Do not use this as an open relay to private or loopback networks.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
# cert=/run/secrets/turn-cert.pem
# pkey=/run/secrets/turn-key.pem
